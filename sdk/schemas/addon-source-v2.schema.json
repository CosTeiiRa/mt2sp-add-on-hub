{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Hub author source format 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "id", "version", "name", "license", "requires", "conflicts", "components"],
  "properties": {
    "format_version": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "maxLength": 128, "description": "SemVer 2; validated by the package loader."},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "license": {"type": "string", "minLength": 1, "maxLength": 200},
    "requires": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/range"}
    },
    "conflicts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "components": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {"client": {"$ref": "#/$defs/component"}, "server": {"$ref": "#/$defs/component"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
    "range": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Up to eight whitespace-separated exact or >, >=, <, <= SemVer comparators."},
    "path": {"type": "string", "minLength": 1, "maxLength": 220, "pattern": "^[A-Za-z0-9_./-]+$", "description": "Relative portable path. Loader also rejects traversal, reserved Windows names, links and collisions."},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "capabilities", "files"],
      "properties": {
        "api": {"$ref": "#/$defs/range"},
        "capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "files": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {"$ref": "#/$defs/path"},
              "target": {"$ref": "#/$defs/path"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Optional in source. The build command computes this from payload bytes for the archive."}
            }
          }
        }
      }
    }
  }
}
